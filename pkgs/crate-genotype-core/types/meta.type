GtMeta: {
  exitCode: i32,
  paths: GtMetaPaths,
  timing: GtMetaTiming,
  modules: [GtMetaModule]
}

GtMetaPaths: {
  src: string,
  dist: string,
  ts?: GtMetaPathsLang,
  rs?: GtMetaPathsLang,
  py?: GtMetaPathsLang
}

GtMetaPathsLang: {
  pkg: string,
  src: string
}

GtMetaTiming: {
  totalMs: u64,
  loadProjectMs: u64,
  loadModulesMs: u64,
  compileMs: u64
}

GtMetaModule: {
  source: string,
  ts?: string,
  rs?: string,
  py?: string
}
