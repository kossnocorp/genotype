{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "incremental": true,
    "tsBuildInfoFile": "../../.ts/tests.tsbuildinfo"
  },
  "include": ["*.ts"]
}
