---
// NOTE: StarlightPage must always be the first import in the file!
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import PlaygroundDemo from "#/ui/playground/PlaygroundDemo.astro";
---

<StarlightPage
  frontmatter={{
    title: "Genotype Playground",
    description: "Genotype Programming Language Playground",
    template: "splash",
    bare: true,
  }}
  hasSidebar={false}
>
  <div class="fullscreen-playground">
    <PlaygroundDemo />
  </div>
</StarlightPage>

<style>
  .fullscreen-playground {
    display: flex;
    flex: none;
    min-height: 0;
    height: calc(
      100dvh - var(--sl-nav-height) - var(--sl-mobile-toc-height, 0px)
    );
    overflow: hidden;
  }
</style>
