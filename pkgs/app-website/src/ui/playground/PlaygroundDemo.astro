---
import Playground from "./Playground.astro";
import type { PlaygroundManager } from "#/ui/playground/PlaygroundManager";

const exampleFiles = import.meta.glob<string>(
  "../../../examples/playground/*/{genotype.toml,src/**/*.type}",
  { eager: true, query: "?raw", import: "default" },
);

const examples = (
  [
    { id: "pokemon", label: "Pokémon TCG", lang: "ts" },
    { id: "language-tour", label: "Language Tour", lang: "ts" },
    { id: "zod", label: "Zod", lang: "ts" },
    { id: "python-legacy", label: "Python Legacy", lang: "py" },
    { id: "python-modern", label: "Python Modern", lang: "py" },
  ] as const
).map(({ id, label, lang }): PlaygroundManager.Example => {
  const prefix = `../../../examples/playground/${id}/`;
  const files = Object.fromEntries(
    Object.entries(exampleFiles)
      .filter(([path]) => path.startsWith(prefix))
      .map(([path, content]) => [path.slice(prefix.length), content]),
  );

  return {
    id,
    label,
    initialState: {
      lang,
      files,
      filePath: id === "language-tour" ? "src/guide.type" : null,
    },
  };
});

const initialState = examples[0]?.initialState;
---

<Playground initialState={initialState} examples={examples} />
