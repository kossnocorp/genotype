---
import Playground from "./Playground.astro";
import type { PlaygroundManager } from "#/ui/playground/PlaygroundManager";

const demoFiles = import.meta.glob("../../../examples/demo/**/*", {
  eager: true,
  query: "?raw",
});

const files = Object.fromEntries(
  await Promise.all(
    Object.entries(demoFiles).map(async ([relPath, module]) => {
      const path = relPath.replace("../../../examples/demo/", "");
      // NOTE: Astro's ?raw incorrectly identify `module` as a string
      const content = (module as any).default;
      return [path, content];
    }),
  ),
);

const initialState: PlaygroundManager.InitialState = {
  lang: "ts",
  files,
  filePath: null,
};
---

<Playground initialState={initialState} />
