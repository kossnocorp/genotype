---
import type { EditorManager } from "./EditorManager";

interface Props {
  id: string;
  initialState: EditorManager.State;
  lineNumbers?: boolean;
}

const { id, initialState, lineNumbers = true } = Astro.props;
---

<gt-editor
  data-id={id}
  data-initial-state={JSON.stringify(initialState)}
  data-line-numbers={String(lineNumbers)}
></gt-editor>

<script>
  import { EditorWebComponent } from "./EditorWebComponent";

  EditorWebComponent.register();
</script>

<style>
  gt-editor {
    @apply block h-full overflow-hidden;
  }
</style>
