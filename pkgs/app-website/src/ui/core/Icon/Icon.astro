---
import type { ImageMetadata } from "astro";
import type { IconTypes } from "./Icon.types";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type Props = IconTypes.Props;

// NOTE: To avoid load compilation times, each used icon id must be listed
// inside `{...}.svg`.
// TODO: Test the performance after Astro upgrades to the Rolldown-powered
// Vite version.
// https://fonts.google.com/icons
const icons100 = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../node_modules/@material-symbols/svg-100/rounded/{TODO,TODO}.svg",
);

// https://fonts.google.com/icons
const icons200 = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../node_modules/@material-symbols/svg-200/rounded/{code_blocks,close,file_export,edit_document,draft,content_copy,check}.svg",
);

// https://fonts.google.com/icons
const icons300 = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../node_modules/@material-symbols/svg-300/rounded/{forum,TODO}.svg",
);

// https://fontawesome.com/search?f=brands&ic=free-collection
const iconsBrands = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../node_modules/@fortawesome/fontawesome-free/svgs/brands/{github,discord}.svg",
);

// https://devicon.dev/
const iconsDev = import.meta.glob<{ default: ImageMetadata }>(
  "../../../../node_modules/devicon/icons/{typescript,rust,python}/*.svg",
);

const iconsAssets = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/**/*.svg",
);

let classList: string[] = [];
if ("class" in Astro.props) {
  const { class: className } = Astro.props;
  if (className) classList.push(className);
}

let directProps: IconTypes.PropsDirect;
if ("prop" in Astro.props) {
  const { prop } = Astro.props;
  if (typeof prop === "string") {
    directProps = { id: prop };
  } else if (typeof prop === "function") {
    directProps = { Factory: prop };
  } else {
    directProps = prop;
  }
} else {
  directProps = Astro.props;
}

let IconFactory: AstroComponentFactory;
if ("id" in directProps) {
  const { id, style } = directProps;
  const iconFilePath =
    style === "brands"
      ? `../../../../node_modules/@fortawesome/fontawesome-free/svgs/brands/${id}.svg`
      : style === "dev"
        ? Object.keys(iconsDev).find(
            (path) => path.includes(id) && path.endsWith("plain.svg"),
          ) ||
          Object.keys(iconsDev).find(
            (path) => path.includes(id) && path.endsWith("original.svg"),
          )
        : style === "assets"
          ? Object.keys(iconsAssets).find((path) => path.includes(`${id}.svg`))
          : `../../../../node_modules/@material-symbols/svg-${style || "200"}/rounded/${id}.svg`;

  if (!iconFilePath) throw new Error(`Icon ${id} has not been found `);

  const icons =
    style === "brands"
      ? iconsBrands
      : style === "dev"
        ? iconsDev
        : style === "assets"
          ? iconsAssets
          : style === "200"
            ? icons200
            : style === "300"
              ? icons300
              : style === "100"
                ? icons100
                : icons200;

  const iconPath = icons[iconFilePath];
  if (!iconPath)
    throw new Error(`Icon ${id} has not been found at ${iconFilePath}`);

  IconFactory = await iconPath().then(
    (m) => m.default as unknown as AstroComponentFactory,
  );
} else {
  IconFactory = directProps.Factory;
}

const { style } = directProps;
---

<IconFactory class:list={["icon", style && `is-${style}`, ...classList]} />
